{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "▶ Run/Debug Active JS File (Node.js)",
      "program": "${file}",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "🌐 Launch Chrome with Live Server",
      "url": "http://localhost:5500/${relativeFile}",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
